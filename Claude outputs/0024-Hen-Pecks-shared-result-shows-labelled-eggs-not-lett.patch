From 5eafe36afbc39ef6eed29eda680ec85d8f3d8ea9 Mon Sep 17 00:00:00 2001
From: Mayuka <mayuka.bulath@gmail.com>
Date: Mon, 28 Sep 2026 07:11:47 -0400
Subject: [PATCH] Hen Pecks: shared result shows labelled eggs, not letter-like
 boxes
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The row of yellow and white squares looked like letter tiles, so people
expected one per letter. It's one per peck, so it now reads
"Pecks: 🥚🐣🐣…" (a chick when the peck found letters). The loss line
uses a rain cloud instead of an egg so the egg only means one thing.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01GKgAE6UQXrAkQA3B7pXEQL
---
 pecks.html | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/pecks.html b/pecks.html
index a598b8c..4cbe6a9 100644
--- a/pecks.html
+++ b/pecks.html
@@ -786,10 +786,11 @@ function renderDist(animate){
 // Older saved games have no outcome, so fall back to how they were stored.
 function wonByPecks(){ return S.outcome ? S.outcome === "pecks" : S.pecks.length < MAX_PECKS && !S.tries; }
 function shareText(){
-  const eggs = S.pecks.map((k,n) => S.hitsPerPeck[n] ? "🟨" : "⬜").join("");
-  const end = S.phase === "won" ? (wonByPecks() ? "Cracked with pecks alone 🐔" : `Cracked on try ${S.solvedOnTry}/${MAX_TRIES} 🐔`) : "The phrase got away 🥚";
+  // One egg per peck: a hatched chick when it found letters, a plain egg when it didn’t.
+  const eggs = S.pecks.map((k,n) => S.hitsPerPeck[n] ? "🐣" : "🥚").join("");
+  const end = S.phase === "won" ? (wonByPecks() ? "Cracked with pecks alone 🐔" : `Cracked on try ${S.solvedOnTry}/${MAX_TRIES} 🐔`) : "The phrase got away 🌧️";
   const hard = S.phase === "won" && S.hard && !S.hintUsed ? " · Hard mode 🌶️" : "";
-  return `Hen Pecks #${DAY_INDEX + 1}${hard}\n${eggs}\n${end}\n${location.origin}${location.pathname}`;
+  return `Hen Pecks #${DAY_INDEX + 1}${hard}\nPecks: ${eggs}\n${end}\n${location.origin}${location.pathname}`;
 }
 $("share").addEventListener("click", async () => {
   const text = shareText();
-- 
