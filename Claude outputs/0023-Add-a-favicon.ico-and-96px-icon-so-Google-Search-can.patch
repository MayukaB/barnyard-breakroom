From 0adf476929a6c19bf13912096b08bd8e86e1f145 Mon Sep 17 00:00:00 2001
From: Mayuka <mayuka.bulath@gmail.com>
Date: Mon, 28 Sep 2026 05:52:38 -0400
Subject: [PATCH] Add a favicon.ico and 96px icon so Google Search can show the
 pig

Google Search wants a square icon of at least 48x48 and looks for
/favicon.ico. The site only had an SVG and a 32px PNG. Both pages now
link a 16/32/48 favicon.ico and a 96px PNG, and the deploy step
publishes them.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01GKgAE6UQXrAkQA3B7pXEQL
---
 .github/workflows/daily.yml |   2 +-
 favicon-96.png              | Bin 0 -> 5967 bytes
 favicon.ico                 | Bin 0 -> 7628 bytes
 index.html                  |   2 ++
 pecks.html                  |   2 ++
 5 files changed, 5 insertions(+), 1 deletion(-)
 create mode 100644 favicon-96.png
 create mode 100644 favicon.ico

diff --git a/.github/workflows/daily.yml b/.github/workflows/daily.yml
index e9a8b3b..b0bf5d6 100644
--- a/.github/workflows/daily.yml
+++ b/.github/workflows/daily.yml
@@ -54,7 +54,7 @@ jobs:
         with:
           ref: main
       - name: Collect site files
-        run: mkdir _site && cp index.html pecks.html pecks-art.js stories.json favicon.svg favicon-32.png apple-touch-icon.png og-story.png og-pecks.png _site/
+        run: mkdir _site && cp index.html pecks.html pecks-art.js stories.json favicon.svg favicon.ico favicon-96.png favicon-32.png apple-touch-icon.png og-story.png og-pecks.png _site/
       - uses: actions/configure-pages@v5
       - uses: actions/upload-pages-artifact@v3
         with:
diff --git a/favicon-96.png b/favicon-96.png
new file mode 100644
