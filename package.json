    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.56.1",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "prettier": "^3.9.9"
  }
}
